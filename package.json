{
  "name": "tp-growth-pool",
  "version": "1.0.0",
  "private": true,
  "description": "TP Growth Pool v1.0 - Trading Point member platform (Next.js 15 + Supabase)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
